# All backend settings use the TRDD_BE_ prefix.
TRDD_BE_APP_NAME=tarakdingdung
TRDD_BE_APP_VERSION=v0.1.0-dev.1

TRDD_BE_LOGGER_FORMAT=json
TRDD_BE_LOGGER_LEVEL=INFO

TRDD_BE_POSTGRES_HOST=127.0.0.1
TRDD_BE_POSTGRES_PORT=5432
TRDD_BE_POSTGRES_USERNAME=postgres
TRDD_BE_POSTGRES_PASSWORD=postgres
TRDD_BE_POSTGRES_DATABASE=tarakdingdung
TRDD_BE_POSTGRES_POOL_SIZE=20

# The address uvicorn binds. Under docker-compose the same value is used for
# the container port, the published host port and the healthcheck, so this is
# the only place the HTTP port is set.
TRDD_BE_HTTP_HOST=0.0.0.0
TRDD_BE_HTTP_PORT=8888
TRDD_BE_HTTP_CORS_ALLOWED_ORIGINS=*

# Interface docker-compose publishes the API on. Default 127.0.0.1 keeps it
# host-only. Set a LAN/tailnet address (e.g. 192.168.18.18) or 0.0.0.0 when
# another machine or the separate frontend container stack must reach it.
TRDD_BE_BIND_HOST=127.0.0.1

TRDD_BE_TOKEN_ACCESS_SECRET=tarakdingdung-access-secret
TRDD_BE_TOKEN_REFRESH_SECRET=tarakdingdung-refresh-secret
TRDD_BE_TOKEN_ACCESS_TTL_SECONDS=900
TRDD_BE_TOKEN_REFRESH_TTL_SECONDS=86400

TRDD_BE_PASSWORD_BCRYPT_COST=12

TRDD_BE_SEED_SUPER_PASSWORD=changeme12345
TRDD_BE_SEED_ADMIN_PASSWORD=changeme12345
TRDD_BE_SEED_USER_PASSWORD=changeme12345

TRDD_BE_INDODAX_API_KEY=changemeindodaxapikey
TRDD_BE_INDODAX_SECRET_KEY=changemeindodaxsecretkey

# LLM decision maker (OpenAI-compatible chat completions)
TRDD_BE_LLM_BASE_URL=https://api.deepseek.com
TRDD_BE_LLM_API_KEY=changemellmapikey
TRDD_BE_LLM_MODEL=deepseek-chat

# Engine. Cron drives the cycle; engine_mode is paper or live.
TRDD_BE_CRON_ENABLED=false
TRDD_BE_ENGINE_ENABLED=false
TRDD_BE_ENGINE_MODE=paper
TRDD_BE_ENGINE_INTERVAL_SECONDS=86400
TRDD_BE_ENGINE_VENUE=indodax
TRDD_BE_UNIVERSE_ID=default
TRDD_BE_ENGINE_INITIAL_EQUITY=10000000
