# Frontend configuration. Copy to .env and adjust:  cp .env.example .env
#
# Every variable uses the TRDD_FE_ prefix and is read server-side only — none
# are NEXT_PUBLIC_, so nothing here is exposed to the browser bundle.

# Base URL of the tarakdingdung backend API. From inside a container, reach a
# backend running on the host with http://host.docker.internal:8888.
TRDD_FE_API_BASE_URL=http://127.0.0.1:8888

# Send the session cookie only over HTTPS. Keep false for local http; set
# true when the app is served behind TLS.
TRDD_FE_COOKIE_SECURE=false

# Host port docker-compose publishes the app on. The container always listens
# on 3000; this only maps the host side. Optional — defaults to 3000.
TRDD_FE_HTTP_PORT=3000
